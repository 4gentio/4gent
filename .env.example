# ---------------------------------------------------------------------------
# 4gent environment. Copy to .env and fill in. NEVER commit a populated .env.
# ---------------------------------------------------------------------------

# Execution ------------------------------------------------------------------
# paper = simulate fills against live quotes; live = sign and broadcast.
EXECUTION_MODE=paper
# Live mode additionally requires the file referenced by LIVE_CONFIRMATION_FILE
# to exist on disk and contain the exact phrase in LIVE_CONFIRMATION_PHRASE.
LIVE_CONFIRMATION_FILE=.LIVE_CONFIRMED
LIVE_CONFIRMATION_PHRASE=I understand 4gent will trade real funds
KILL_SWITCH_FILE=.KILL_SWITCH

# Chain ----------------------------------------------------------------------
BNB_RPC_PRIMARY=https://bsc-dataseed.bnbchain.org
BNB_RPC_FALLBACK=https://bsc-dataseed1.defibit.io
CHAIN_ID=56
# Hex private key, 0x-prefixed. Env only. Never persisted, never logged.
WALLET_PRIVATE_KEY=
# Optional: read-only address for paper mode when no key is supplied.
WALLET_ADDRESS=

# Anthropic ------------------------------------------------------------------
ANTHROPIC_API_KEY=
MODEL_REASONING=claude-sonnet-4-6
MODEL_CLASSIFY=claude-haiku-4-5
BRAIN_MAX_TOKENS=4096
BRAIN_TEMPERATURE=0.2

# Persistence ----------------------------------------------------------------
DATABASE_PATH=./data/4gent.db

# Loops (milliseconds) --------------------------------------------------------
PRICE_LOOP_MS=15000
REASONING_LOOP_MS=300000
REASONING_LOOP_ACTIVE_MS=60000
RECONCILE_LOOP_MS=600000
LOOP_JITTER_PCT=15
WATCHDOG_STALL_MULTIPLIER=4

# Risk caps (percent of NAV unless noted) ------------------------------------
MAX_POSITION_PCT=5
MAX_BSTOCK_EXPOSURE_PCT=60
MAX_MEMECOIN_EXPOSURE_PCT=15
MAX_TOTAL_INVESTED_PCT=80
MAX_OPEN_POSITIONS=12
DAILY_DRAWDOWN_BREAKER_PCT=6
WEEKLY_DRAWDOWN_BREAKER_PCT=12
BREAKER_COOLDOWN_HOURS=24
HARD_STOP_BSTOCK_PCT=8
HARD_STOP_MEMECOIN_PCT=20
MIN_TRADE_USD=25

# Slippage / execution guards (basis points) ---------------------------------
SLIPPAGE_CAP_BSTOCK_BPS=60
SLIPPAGE_CAP_MEMECOIN_BPS=300
MAX_PRICE_IMPACT_BPS=500
QUOTE_STALENESS_MS=20000

# Memecoin safety triage -----------------------------------------------------
MAX_BUY_TAX_BPS=500
MAX_SELL_TAX_BPS=500
MIN_LIQUIDITY_USD=25000
MIN_TOKEN_AGE_MINUTES=30
MIN_HOLDER_COUNT=250

# Reference equity prices ----------------------------------------------------
EQUITY_PRICE_PROVIDER=stooq
EQUITY_PRICE_STALE_MS=120000
NAV_DEVIATION_TRIGGER_BPS=75

# Alerts ---------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERTS_ENABLED=false

# Dashboard ------------------------------------------------------------------
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8787
DASHBOARD_HOST=127.0.0.1

# Logging --------------------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=false
